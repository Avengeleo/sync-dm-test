# 复制为 .env 并填写(.env 已被 gitignore)。一个文件管全部服务,按前缀区分。

# ── bi-admin(sync-bi-api)──
# BASE_URL 填 API 网关域名(到 /admin 前那一截),不是前端站点。示例:https://api-http.ramon2025.com
BI_BASE_URL=https://api-http.ramon2025.com
# USERNAME=登录手机号(后台按 mobile 列查账号,不是显示名)
BI_USERNAME=
# PASSWORD=浏览器登录 payload 里的 password 值(前端已 MD5,填那串 32 位 MD5,不是明文)
BI_PASSWORD=
# 可选:托盘图标校验样本(服务器能访问到才有意义)
BI_TRAY_ICON_OK=
BI_TRAY_ICON_BAD=

# ── dm-api(sync-dm-api 网关)── 填齐才跑 dm-api 套件;三层鉴权(AES旁路+签名+token)
# 网关域名(到 scheme://host,不带 /api;APP 走 api-gateway 域名,H5 走 h5-gateway 域名)
DM_API_BASE_URL=
# 版本前缀:APP 用 /api/v2,H5 用 /api/h5
DM_API_PREFIX=/api/h5
# 签名用:sys_apps 表里一条 is_enabled=1 的 app_id 及其 app_secrect
#   查库: SELECT app_id, app_secrect FROM sys_apps WHERE is_enabled=1;
DM_API_APP_ID=
DM_API_APP_SECRET=
# AES 旁路值(Encversion 头=此值即跳过 body 加解密):从配置/运维取,或抓真实请求的 Encversion 头
DM_API_WIPS=
# 有效用户会话 token(live 抓:H5/APP devtools 里请求头 token 的值)
DM_API_TOKEN=
# 可选:部分接口要 Client-type(1=app/2=pc/3=web)
DM_API_CLIENT_TYPE=

# ── 通用 ──
BI_HTTP_TIMEOUT=15

# ── dm-im 长连接(心情回应等 IM 消息)── 走 WebSocket,不是 HTTP
# H5 的 WebSocket 地址(devtools → Network → 筛 WS → 那条连接的 URL,如 wss://imws.ramon2025.com/)
IM_WS_URL=
# 你的 user_id(库 users 表按手机号查,或 H5 app 里)
IM_USER_ID=
# IM 登录 token(login-srv 走 identify-srv 校验;多半就是 DM_API_TOKEN 那个值)
IM_TOKEN=
# 可选:发送端 A 的客户端类型,2=web/H5
IM_CLIENT_TYPE=2
# 收方端 B 的端类型(在线/离线投递测试的第二条连接)。**必须 ≠ IM_CLIENT_TYPE**,否则同端互踢(0x0108)。默认 0=App
IM_CLIENT_TYPE_B=0
# 可选:群回应/群投递测试用——填你真实所在的一个群 id;不填则群用例 skip
IM_GROUP_ID=
# 可选:超级群(频道)回应/投递测试用——填你有权限的一个频道 id;不填则超级群用例 skip
IM_CHANNEL_ID=
# 离线投递测试用:http-gateway 的 HTTP 域名(离线消息走 REST 拉取,非 WS);鉴权/报文格式需 live 抓一次确认;不填则离线用例 skip
IM_HTTP_BASE_URL=
# ── 版本兼容门(v2.21.2 心情回应灰度)测试用 ──
# 模拟老客户端的版本号:必须 < bi 后台 im_feature_gate 表里配的门槛值(线上实测安卓现网 2.20.0)
IM_OLD_APP_VERSION=2.20.0
# 模拟够版本客户端:必须 >= 门槛值(用于"升级补拉"用例)
IM_NEW_APP_VERSION=9.9.9

# 可选:第二个测试账号(跨用户真实单聊投递用;不填则用单账号双连接测投递)
IM_USER_ID2=
IM_TOKEN2=
