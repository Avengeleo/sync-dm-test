# 复制为 .env 并填写(.env 已被 gitignore)。一个文件管全部服务,按前缀区分。

# ── bi-admin(sync-bi-api)──
# BASE_URL 填 API 网关域名(到 /admin 前那一截),不是前端站点。示例:https://api-http.ramon2025.com
BI_BASE_URL=https://api-http.ramon2025.com
# USERNAME=登录手机号(后台按 mobile 列查账号,不是显示名)
BI_USERNAME=
# PASSWORD=浏览器登录 payload 里的 password 值(前端已 MD5,填那串 32 位 MD5,不是明文)
BI_PASSWORD=
# develop 后台开了图形验证(登录 code=50014)时,账号密码登录会被拦。
# 浏览器登完后台,F12 → Network → 任意 /admin/* → 请求头 X-Chat-admin,整段贴这里即可跳过 /admin/login。
BI_TOKEN=
# 可选:一次性图形验证 token(默认约 60 秒、用过即废)。有 BI_TOKEN 时不用填。
BI_DYNAMIC_VERIFY_TOKEN=
# 可选:托盘图标校验样本(服务器能访问到才有意义)
BI_TRAY_ICON_OK=
BI_TRAY_ICON_BAD=

# ── dm-api(sync-dm-api 网关)── 填齐才跑 dm-api 套件;三层鉴权(AES旁路+签名+token)
# 网关域名(到 scheme://host,不带 /api;APP 走 api-gateway 域名,H5 走 h5-gateway 域名)
DM_API_BASE_URL=
# 版本前缀:APP 用 /api/v2,H5 用 /api/h5
DM_API_PREFIX=/api/h5
# 签名用:sys_apps 表里一条 is_enabled=1 的 app_id 及其 app_secrect
#   查库: SELECT app_id, app_secrect FROM sys_apps WHERE is_enabled=1;
DM_API_APP_ID=
DM_API_APP_SECRET=
# AES 旁路值(Encversion 头=此值即跳过 body 加解密):从配置/运维取,或抓真实请求的 Encversion 头
DM_API_WIPS=
# 有效用户会话 token(live 抓:H5/APP devtools 里请求头 token 的值)
# v2.27.0 直播展示指标(test_10/11/12)复用这套 DM_API_*;H5 前缀无语聊,voice_room/detail_v2 会 skip
DM_API_TOKEN=
# 可选:部分接口要 Client-type。取值与后端 constant 一致:0=App 1=PC 2=Web(不是 1/2/3)
DM_API_CLIENT_TYPE=
# PC 扫码登录:test_08 只读可反复跑。test_09 完整授权会踢掉当前 H5/Web 会话(501 登录重置)。
# 建议 DM_API_TOKEN 用 App 端 token;若只用 H5 token,跑完 test_09 必须重抓。
# happy_path 用当前 DM_API_TOKEN,手机/邮箱/账号密码注册都可以。
# 另测邮箱账号时再填一枚(H5/App 抓),配了才跑 test_pc_scan_login_email_account
DM_API_TOKEN_EMAIL=

# ── 通用 ──
BI_HTTP_TIMEOUT=15

# ── dm-im 长连接(心情回应等 IM 消息)── 走 WebSocket,不是 HTTP
# H5 的 WebSocket 地址(devtools → Network → 筛 WS → 那条连接的 URL,如 wss://imws.ramon2025.com/)
IM_WS_URL=
# 你的 user_id(库 users 表按手机号查,或 H5 app 里)
IM_USER_ID=
# IM 登录 token(login-srv 走 identify-srv 校验;多半就是 DM_API_TOKEN 那个值)
IM_TOKEN=
# 可选:发送端 A 的客户端类型,2=web/H5
IM_CLIENT_TYPE=2
# 收方端 B 的端类型(在线/离线投递测试的第二条连接)。**必须 ≠ IM_CLIENT_TYPE**,否则同端互踢(0x0108)。默认 0=App
IM_CLIENT_TYPE_B=0
# 可选:群回应/群投递测试用——填你真实所在的一个群 id;不填则群用例 skip
IM_GROUP_ID=
# 可选:超级群(频道)回应/投递测试用——填你有权限的一个频道 id;不填则超级群用例 skip
IM_CHANNEL_ID=
# 离线投递测试用:http-gateway 的 HTTP 域名(离线消息走 REST 拉取,非 WS);鉴权/报文格式需 live 抓一次确认;不填则离线用例 skip
IM_HTTP_BASE_URL=
# ── 版本兼容门(v2.21.2 心情回应灰度)测试用 ──
# 模拟老客户端的版本号:必须 < bi 后台 im_feature_gate 表里配的门槛值(线上实测安卓现网 2.20.0)
IM_OLD_APP_VERSION=2.20.0
# 模拟够版本客户端:必须 >= 门槛值(用于"升级补拉"用例)
IM_NEW_APP_VERSION=9.9.9

# 可选:第二个测试账号(跨用户真实单聊投递用;不填则用单账号双连接测投递)
# 群音视频自测(test_17)必填:B 作被叫,且必须与 A 同为 IM_GROUP_ID 成员。
# B 的真机 App/PC/H5 请先退出,否则离线用例会被在线投递抢走。
IM_USER_ID2=
IM_TOKEN2=

# ── Vuln20 / Vuln22 dev 安全回归（独立入口，见 docs/IM安全回归.md）──
# 默认不访问真实环境。填 dev 才运行；部署版本填写实际镜像/提交号。
IM_SECURITY_ENV=
IM_SECURITY_DEPLOYMENT=
# 请显式填写确认过的 dev 地址，不自动复用旧 IM_* 地址；TCP 可选，必须显式端口。
IM_SECURITY_WS_URL=
IM_SECURITY_TCP_URL=
IM_SECURITY_HTTP_BASE_URL=
# A/B 必须是两个专用账号、各自有效 token。留空复用 IM_USER_ID/TOKEN 及 IM_USER_ID2/TOKEN2。
IM_SECURITY_USER_ID=
IM_SECURITY_TOKEN=
IM_SECURITY_USER_ID2=
IM_SECURITY_TOKEN2=
# 私密频道 P：A 是成员，B 不是成员，至少有一条 A 可读的非空普通消息。
# 留空复用 IM_CHANNEL_ID；验证 100 条上限需预先有至少 101 条消息，脚本不会补数。
IM_SECURITY_CHANNEL_ID=
# P 中固定的全员普通广播消息 ID；确认它原本对 B 可见（见指南），再将确认位置 1。
IM_SECURITY_CHANNEL_MESSAGE_ID=
IM_SECURITY_BROADCAST_CONFIRMED=0
# 可选频道 Q：B 是成员、A 不是成员，至少一条非空普通消息（混合权限请求）。
IM_SECURITY_OTHER_CHANNEL_ID=
# 登录会修改在线状态/可能踢线，确认使用专用账号后置 1；默认跳过 Vuln20。
IM_SECURITY_ALLOW_LOGIN=0
# 留空复用 IM_CLIENT_TYPE / IM_TIMEOUT / IM_NEW_APP_VERSION。
IM_SECURITY_CLIENT_TYPE=
IM_SECURITY_TIMEOUT=
IM_SECURITY_APP_VERSION=
# 可选手工退群/重入：独立频道 C，初始 A/B 都是成员，同一条普通广播始终是最新消息。
IM_SECURITY_LIFECYCLE_CHANNEL_ID=
IM_SECURITY_LIFECYCLE_MESSAGE_ID=
# 依次手工选择 member_warm / after_quit / rejoined；脚本不执行退群、重入。
IM_SECURITY_MEMBERSHIP_PHASE=

# ── Vuln42 / Vuln43 / Vuln47 自测，见 docs/IM安全回归42-43-47.md ──
# 复用上方 dev 地址、A/B 账号、clientType 与实际部署版本；不自动登录或连接生产。
# Vuln42 专用安静频道：A/B 都是成员，不能复用 Vuln22 的 A成员/B非成员频道 P。
IM_SECURITY_IDENTITY_CHANNEL_ID=
IM_SECURITY_IDENTITY_MESSAGE_ID=
# 已确认固定普通广播双方可读、专用账号、频道不会被其他客户端消费时置1。
IM_SECURITY_IDENTITY_FIXTURE_CONFIRMED=0
# 更新已读/操作ACK及部分“读取”会推进状态，默认不执行。
# 状态确认包含A/B所有加入频道均为专用测试范围、客户端均已停止消费；准备好再置1。
IM_SECURITY_IDENTITY_ALLOW_WRITE=0
IM_SECURITY_IDENTITY_STATE_CONFIRMED=0
# 写状态不能自动回退；一次选v1或v2，换版本前手工重置待处理操作/已读夹具。
IM_SECURITY_IDENTITY_WRITE_VERSION=

# Vuln43 设备列表为只读；踢设备仅限 A/B 的专用 Web(slot=2)，会关闭连接/撤销登录token。
IM_SECURITY_ALLOW_DEVICE_KICK=0
# 每次只选一个阶段：forged_uid / own_uid；版本：v1 / v2。
# 每个阶段前重新准备A/B的在线专用Web设备；不会自动重新登录或恢复真实会话。
IM_SECURITY_DEVICE_KICK_PHASE=
IM_SECURITY_DEVICE_KICK_VERSION=
IM_SECURITY_DEVICE_TOKEN=
IM_SECURITY_DEVICE_TOKEN2=
# 基础 TOKEN/TOKEN2 必须与上方A/B目标Web设备对应。
# 下方为另一个客户端的独立观察token，必须分别不同于 TOKEN/TOKEN2。
IM_SECURITY_DEVICE_OBSERVER_TOKEN=
IM_SECURITY_DEVICE_OBSERVER_TOKEN2=

# Vuln47：手工触发场景、导出dev日志后，填写本地manifest绝对路径。凭证/日志均不能提交。
# 模板见 docs/examples/im-security-v47-manifest.example.json，日志文件只在本地扫描。
IM_SECURITY_LOG_MANIFEST=

# ── Vuln44 / Vuln45：只测本轮消息归属与密钥同步身份，见 docs/IM安全回归44-45.md ──
# 复用上方dev地址、实际部署版本、两个专用账号；不会自动恢复失效token。
# 44要求A/B互为好友、无在线Web，允许仅对本轮新建普通单聊做编辑/撤回。
IM_SECURITY_MUTATION_ALLOW_WRITE=0
IM_SECURITY_MUTATION_FIXTURE_CONFIRMED=0
# 45要求A/B专用账号App/PC/Web均离线，使用同一个专用普通群，不能使用42超级群R。
# 测试只发送opaque marker，不读取、替换或生成真实私钥；会ACK本轮交换记录。
IM_SECURITY_KEY_IDENTITY_ALLOW_WRITE=0
IM_SECURITY_KEY_IDENTITY_FIXTURE_CONFIRMED=0
IM_SECURITY_KEY_GROUP_ID=
# 可选：已确认不在专用普通群中的另一个测试账号UID，不需要其token，不探测真实用户。
IM_SECURITY_KEY_NONMEMBER_UID=

# ── P2：Vuln85 / 86 / 92，只通过 python -m im_test.run_security_p2 调度 ──
# 另建git忽略的.security/im-p2.env，只复制dev地址、有效专用A/B凭证及实际部署版本。
# 所有连接/写许可只由CLI在隔离子进程临时开启，不在此处持久打开。
IM_SECURITY_P2_ALLOW_WRITE=0
IM_SECURITY_P2_FIXTURE_CONFIRMED=0
# 85：A是群主、B是普通成员，双方App/PC/Web均离线；专用普通群，不能复用频道P/Q/R。
IM_SECURITY_P2_GROUP_ID=
IM_SECURITY_P2_GROUP_OWNER_UID=
# 仅跨群撤回用：A/B都在另一个获准测试的普通群；缺失则跨群项受阻。
IM_SECURITY_P2_OTHER_GROUP_ID=
IM_SECURITY_P2_HTTP_VERSION=
# 86：明确选择ws/tcp；按实际配置填写有效上限和cmdLimitRate，不能猜测。
IM_SECURITY_P2_TRANSPORT=
IM_SECURITY_P2_MAX_FRAME_BYTES=
IM_SECURITY_P2_CMD_LIMIT_RATE=
# 92：本地robot-srv完整原始日志导出与三类SQL执行证据；见docs/examples模板。
IM_SECURITY_P2_SQL_MANIFEST=
